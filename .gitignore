# =====================================================
# Ignore everything except these tracked roots
# =====================================================
/*
!/XR-Ad_block/
!/XR-Ad_block/**
!/AI-core/
!/AI-core/**
!/requirements.txt

# =====================================================
# Unity (XR-Ad_block)
# =====================================================

# Unity generated folders
XR-Ad_block/[Ll]ibrary/
XR-Ad_block/[Tt]emp/
XR-Ad_block/.utmp/
XR-Ad_block/[Oo]bj/
XR-Ad_block/[Bb]uild/
XR-Ad_block/[Bb]uilds/
XR-Ad_block/[Ll]ogs/
XR-Ad_block/[Uu]ser[Ss]ettings/
XR-Ad_block/[Mm]emoryCaptures/

# Unity performance test artifacts (auto-generated)
XR-Ad_block/Assets/Resources/PerformanceTestRunInfo.json
XR-Ad_block/Assets/Resources/PerformanceTestRunSettings.json

# Auto-generated IDE files
XR-Ad_block/*.csproj
XR-Ad_block/*.sln
XR-Ad_block/*.user
XR-Ad_block/*.unityproj
XR-Ad_block/*.pidb
XR-Ad_block/*.booproj
XR-Ad_block/*.svd

XR-Ad_block/.vs/
XR-Ad_block/.vscode/
XR-Ad_block/.idea/
!XR-Ad_block/.config/
!XR-Ad_block/.config/dotnet-tools.json
# =====================================================
# AI-core (Python / ML)
# =====================================================

# Python cache
AI-core/__pycache__/
AI-core/**/*.pyc
AI-core/**/*.pyo

# Virtual environments
AI-core/venv/
AI-core/.venv/

# Training outputs
AI-core/runs/

# OS junk
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# General cache files
*.cache

# Ignore dataset contents but keep folder structure
AI-core/test/images/*
AI-core/test/labels/*

AI-core/train/images/*
AI-core/train/labels/*

AI-core/valid/images/*
AI-core/valid/labels/*

# Keep the folders themselves
!AI-core/test/images/.gitkeep
!AI-core/test/labels/.gitkeep
!AI-core/train/images/.gitkeep
!AI-core/train/labels/.gitkeep
!AI-core/valid/images/.gitkeep
!AI-core/valid/labels/.gitkeep
