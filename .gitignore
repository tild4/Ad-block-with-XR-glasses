# =====================================================
# Ignore everything except these tracked roots
# =====================================================
/*
!/XR-Ad_block/
!/XR-Ad_block/**
!/AI-core/
!/AI-core/**
!/requirements.txt

# =====================================================
# Unity (XR-Ad_block)
# =====================================================

# Unity generated folders
XR-Ad_block/[Ll]ibrary/
XR-Ad_block/[Tt]emp/
XR-Ad_block/.utmp/
XR-Ad_block/[Oo]bj/
XR-Ad_block/[Bb]uild/
XR-Ad_block/[Bb]uilds/
XR-Ad_block/[Ll]ogs/
XR-Ad_block/[Uu]ser[Ss]ettings/
XR-Ad_block/[Mm]emoryCaptures/

# Unity performance test artifacts (auto-generated)
XR-Ad_block/Assets/Resources/PerformanceTestRunInfo.json
XR-Ad_block/Assets/Resources/PerformanceTestRunSettings.json

# Auto-generated IDE files
XR-Ad_block/*.csproj
XR-Ad_block/*.sln
XR-Ad_block/*.user
XR-Ad_block/*.unityproj
XR-Ad_block/*.pidb
XR-Ad_block/*.booproj
XR-Ad_block/*.svd

XR-Ad_block/.vs/
XR-Ad_block/.vscode/
XR-Ad_block/.idea/
!XR-Ad_block/.config/
!XR-Ad_block/.config/dotnet-tools.json

*.ninja_log
*.ninja_deps
*.cmake
CMakeCache.txt
# =====================================================
# AI-core (Python / ML)
# =====================================================

# Python cache
AI-core/__pycache__/
AI-core/**/__pycache__/
AI-core/**/*.pyc
AI-core/**/*.pyo

# Virtual environments (any depth, any name)
AI-core/venv/
AI-core/.venv/
AI-core/**/venv/
AI-core/**/.venv/
AI-core/**/env/

# Training outputs
AI-core/runs/

# =====================================================
# AI-core/NLP — HuggingFace / PyTorch training artifacts
# =====================================================

# HuggingFace Trainer outputs (checkpoints, logs, optimizer state)
AI-core/NLP/**/results/
AI-core/NLP/**/checkpoint-*/
AI-core/NLP/**/runs/
AI-core/NLP/**/logs/

# Intermediate saved models (we only commit the final ONNX export under models/)
AI-core/NLP/**/saved_model/
AI-core/NLP/**/*.safetensors
AI-core/NLP/**/*.bin
AI-core/NLP/**/*.pt
AI-core/NLP/**/*.pth

# HuggingFace cache (if it ends up inside the repo)
AI-core/NLP/**/.cache/
AI-core/NLP/**/hf_cache/

# OS junk
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# General cache files
*.cache

# Ignore dataset contents but keep folder structure
AI-core/test/images/*
AI-core/test/labels/*

AI-core/train/images/*
AI-core/train/labels/*

AI-core/valid/images/*
AI-core/valid/labels/*

# Keep the folders themselves
!AI-core/test/images/.gitkeep
!AI-core/test/labels/.gitkeep
!AI-core/train/images/.gitkeep
!AI-core/train/labels/.gitkeep
!AI-core/valid/images/.gitkeep
!AI-core/valid/labels/.gitkeep
